      "html": "<button class=\"ds-icon-btn\" aria-label=\"Close\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M6 6l12 12M18 6L6 18\"/></svg></button>",
      "css": ".ds-icon-btn{display:inline-grid;place-items:center;width:40px;height:40px;border:1px solid #45321f;border-radius:50%;background:#2e2017;color:#f6eadb;cursor:pointer}.ds-icon-btn:hover{border-color:rgb(245 180 50/.55)}.ds-icon-btn:active{transform:scale(.94)}.ds-icon-btn:focus-visible{outline:2px solid #f5b432;outline-offset:2px}"
