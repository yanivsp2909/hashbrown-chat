    {
      "name": "Order Ticket",
      "kind": "card",
      "refersTo": "ticket",
      "description": "Rail ticket clipped to the bar, with a draining invite timer.",
      "html": "<div class=\"ds-ticket\"><div class=\"ds-ticket-top\"><b>Tic-Tac-Toe</b><span class=\"ds-no\">#12</span></div><div class=\"ds-line\">Noa challenges you</div><div class=\"ds-drain\"><span></span></div><button class=\"ds-tk-btn\">Accept</button></div>",
      "css": ".ds-ticket{position:relative;width:236px;padding:18px 14px 14px;display:grid;gap:8px;background:#f8f0e3;color:#2b1d12;border-radius:4px 4px 10px 10px;box-shadow:0 1px 1px rgb(0 0 0/.25),0 8px 18px rgb(0 0 0/.28);font:400 15px/1.5 ui-rounded,system-ui,sans-serif}.ds-ticket::before{content:\"\";position:absolute;top:-4px;left:50%;width:46px;height:12px;translate:-50% 0;border-radius:3px;background:#6a4321}.ds-ticket-top{display:flex;justify-content:space-between;align-items:baseline}.ds-ticket-top b{font-weight:800}.ds-no{font:11.5px ui-monospace,monospace;color:#6f5844;font-variant-numeric:tabular-nums}.ds-line{font-size:13.5px;color:#6f5844}.ds-drain{height:4px;border-radius:4px;background:#e6d8c4;overflow:hidden}.ds-drain span{display:block;height:100%;width:60%;background:#9c8670}.ds-tk-btn{min-height:34px;border:0;border-radius:999px;background:#f5b432;color:#2a1904;font-weight:650;cursor:pointer}.ds-tk-btn:hover{background:#ffc54d}.ds-tk-btn:focus-visible{outline:2px solid #8a5600;outline-offset:2px}"
    },
    {
      "name": "Sauce Notices",
      "kind": "custom",
      "refersTo": "notice-event",
      "description": "Chat notices tinted by meaning: event, error, money, private.",
      "html": "<div class=\"ds-n ds-ev\">Daily bonus is live</div><div class=\"ds-n ds-er\">That room is full. Try another.</div><div class=\"ds-n ds-mo\">+50 tokens</div><div class=\"ds-n ds-pr\">Noa whispers: hi</div>",
      "css": ".ds-n{margin:4px 0;padding:8px 12px;border-radius:12px;font:400 14px/1.5 ui-rounded,system-ui,sans-serif}.ds-ev{background:rgb(203 184 90/.13);color:#cbb85a}.ds-er{background:rgb(255 111 91/.12);color:#ff6f5b}.ds-mo{background:rgb(154 214 111/.12);color:#9ad66f}.ds-pr{background:rgb(187 169 255/.13);color:#bba9ff;box-shadow:0 0 0 2px #bba9ff inset}"
    },
    {
      "name": "Turn Pill",
      "kind": "chip",
      "refersTo": "turn-pill-lit",
      "description": "Gold only when it is your move.",
      "html": "<span class=\"ds-pill ds-lit\">Your turn</span> <span class=\"ds-pill\">Waiting for Noa</span>",
      "css": ".ds-pill{display:inline-block;padding:5px 12px;border-radius:999px;background:#3a2a1e;color:#dcc6ae;font:700 14px ui-rounded,system-ui,sans-serif}.ds-lit{background:#f5b432;color:#2a1904}"
    },
    {
      "name": "Wordle Row",
      "kind": "custom",
      "refersTo": "board-plate",
      "description": "Game-semantic tiles on the 348px plate width; yellow is not the action gold.",
      "html": "<div class=\"ds-row\"><span class=\"ds-t ds-g\">c</span><span class=\"ds-t ds-y\">r</span><span class=\"ds-t ds-x\">i</span><span class=\"ds-t\">s</span><span class=\"ds-t\">p</span></div>",
      "css": ".ds-row{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;width:min(348px,100%)}.ds-t{aspect-ratio:1;display:grid;place-items:center;border-radius:8px;border:2px solid #45321f;background:#120c08;color:#f6eadb;font:850 24px ui-rounded,system-ui,sans-serif;text-transform:uppercase}.ds-g{background:#4f9a35;border-color:#4f9a35;color:#fff}.ds-y{background:#c49a1d;border-color:#c49a1d;color:#1f1503}.ds-x{background:#5b4b3e;border-color:#5b4b3e;color:#f1e6d8}"
    }
  ],
  "narrative": {
    "northStar": "Fry Station",
    "overview": "A night-shift snack-bar kitchen run by a potato. The shell is roasted and warm (deep brown ground, crust-brown cards, fryer-oil neutrals), deliberately not the gray-plus-blurple chat default. Anything that needs the user (a challenge, a live match, a Wordle in progress) hangs on a ticket rail across the top of the chat as a paper order ticket clipped to a bar; finished games stamp the ticket WON, LOST or DRAW.\n\nDensity is chat-dense but friendly: rounded system type, pill buttons, soft shadows. Dark is the default and required; a light \"bun\" theme keeps every role and swaps only values.",
    "keyCharacteristics": [
      "Gold means \"you can press this\" and nothing else.",
      "Semantic sauces: mustard events, ketchup errors and losses, pickle money, lavender private.",
      "Paper order tickets with a crust-coloured clip, used for the login card and every rail item.",
      "Every game board sits on one fixed 348px plate.",
      "System rounded sans only; tabular figures for every number."
    ],
    "rules": [
      {
        "name": "The Gold Is For Pressing Rule",
        "body": "Golden Crisp appears only on things the user can act on, or on the state that asks them to act (your turn, a lit ticket). Never use it for decoration, headings or status.",
        "section": "colors"
      },
      {
        "name": "The Sauce Rule",
        "body": "Mustard means an event, ketchup means an error or a loss, pickle means money, lavender means private. A colour never takes on a second meaning.",
        "section": "colors"
      },
      {
        "name": "The Game Semantics Exception",
        "body": "Wordle green/yellow/gray tiles, Damka red and blue pieces, the wood board and the stamp inks follow game convention and are defined locally in the game stylesheet. Wordle yellow is a game result, not the gold action colour, and must never be swapped for it.",
        "section": "colors"
      },
      {
        "name": "The System Type Rule",
        "body": "No downloaded or web fonts (a PRODUCT.md constraint: no CDNs, strict CSP). Rounded comes from ui-rounded where the OS has it, plain system sans elsewhere.",
        "section": "typography"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Times, scores, file sizes, coordinates and ticket numbers all use tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The One Plate Rule",
        "body": "Every board (tic-tac-toe, Damka, math duel) sits on a square plate of min(348px, 100%). The Wordle grid, letter tray and guess form share that same 348px width, so stacked match and Wordle cards line up on one edge.",
        "section": "layout"
      },
      {
        "name": "The Paper Floats Rule",
        "body": "Only paper (tickets, the login card) and transient surfaces (popovers, drawers) cast a strong shadow. Panels never do.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** reserve Golden Crisp for actions and your-turn states.",
      "**Do** keep sauce colours to their single meanings, with their soft tint for backgrounds.",
      "**Do** put any new board on the 348px plate.",
      "**Do** use tabular figures for every number.",
      "**Do** give every motion a reduced-motion fallback (fade or 1ms)."
    ],
    "donts": [
      "**Don't** load web fonts or use CDNs.",
      "**Don't** use gold for headings, dividers, decoration or status.",
      "**Don't** recolour Wordle yellow to the action gold, or the action gold to Wordle yellow.",
      "**Don't** add shadows to the sidebar, chat column or game panel."
    ]
  }
}