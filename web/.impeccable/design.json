  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The gold action; only actionable things are gold.",
      "html": "<button class=\"ds-btn-primary\">Send challenge</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;min-height:40px;padding:0 16px;border:1px solid transparent;border-radius:999px;background:#f5b432;color:#2a1904;font:650 15px/1.5 ui-rounded,system-ui,sans-serif;box-shadow:0 2px 8px rgb(0 0 0/.25);cursor:pointer;transition:background-color 160ms ease,transform 100ms cubic-bezier(.23,1,.32,1)}.ds-btn-primary:hover{background:#ffc54d}.ds-btn-primary:active{transform:scale(.97)}.ds-btn-primary:focus-visible{outline:2px solid #f5b432;outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary actions; border warms to gold on hover.",
      "html": "<button class=\"ds-btn-ghost\">Log out</button>",
      "css": ".ds-btn-ghost{min-height:40px;padding:0 16px;border:1px solid #45321f;border-radius:999px;background:transparent;color:#dcc6ae;font:650 15px/1.5 ui-rounded,system-ui,sans-serif;cursor:pointer;transition:border-color 160ms ease}.ds-btn-ghost:hover{border-color:rgb(245 180 50/.55);color:#f6eadb}.ds-btn-ghost:focus-visible{outline:2px solid #f5b432;outline-offset:2px}"
    },
    {
